# Graphify ignore — FULL codebase (scripts, references, skill code included).
# Same syntax as .gitignore. Merged with .gitignore — this only excludes more.
# Upstream: https://github.com/Graphify-Labs/graphify
#
# Scope: broad knowledge graph for agent query / deep exploration.
# Expect many communities; prefer --scope curated for readable HTML.
# Select with: ./scripts/update_hermes_profile_graphify.sh --scope full
# Sibling: .graphifyignore.curated for overview graphs.

# Generated graph artifacts (rebuild with `graphify extract`)
graphify-out/
**/graphify-out/
agent-knowledge-graph.html
graphify-baseline.tar.gz

# Vendor license blobs (not useful as graph nodes)
skills/_vendor/**

# Eval / fixture noise (NVIDIA skills ship lots of these)
**/evals/**
**/eval/**
**/__pycache__/**
**/*.pyc
**/.pytest_cache/**

# Large / low-signal demo assets inside skills
**/examples/**/datasets/**
**/examples/**/*.pt
**/examples/**/*.onnx
**/examples/**/*.engine
**/*.mp4
**/*.mkv
**/*.wav
**/*.flac

# Non-skill/doc noise from profile root / agent home
home/
pastes/
*.lock
*.db
*.db-shm
*.db-wal
*.sig
*.tar.gz
cron/
logs/
sessions/

# Repo-only (not shipped into the agent corpus)
scripts/
setup.md
token-economy.md
README.md
foundry/

# Hermes files
.skills_prompt_snapshot.json

# macOS system files
._*
.DS_Store
